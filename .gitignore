# ============================================================================
# ncycle-pipeline .gitignore
# Goal: commit the tool + config + small normalized validation artifacts.
# Exclude large/regenerable data (DBs, downloads, per-genome pipeline outputs).
# NOTE: resources/blast_db/ holds cached BLAST reference seqs (incl. 8 N proteins
# whose UniProt accessions were since deleted) — archive it SEPARATELY (e.g.
# Zenodo) and footnote in methods; it is intentionally NOT committed here.
# ============================================================================

# ---- Python / Snakemake / OS cruft ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.snakemake/
.DS_Store
*.log

# ---- Local agent / planning state (not part of the public tool) ----
.claude/
WORKPLAN_backup.md

# ---- Large regenerable resources (archive separately) ----
resources/.cache/
resources/hmm/
resources/blast_db/

# ---- Pipeline run outputs ----
results/

# ---- Validation: KEGG API cache ----
validation/.kegg_cache/

# ---- Validation MAG-realism study ----
# Keep labeled *.fna + reports; drop bulk downloads and per-sample pipeline scratch.
validation/metagenomes/mags_dl/
validation/metagenomes/mags.zip
results_nmag/*/
!results_nmag/figures/

# ---- Comparators: heavy scratch (downloads, proteomes, per-tool I/O) ----
*.zip
comparators/gtdb_pilot/
comparators/dram_in/
comparators/dram_out/
comparators/dram_distill/
comparators/metabolic_in/
comparators/metabolic_out/
# Vendored third-party NCycDB (Tu et al.) — do NOT redistribute; user supplies it.
# build_ncycdb_tsv.py regenerates the normalized ncycdb.tsv we keep.
comparators/NCyc/data/
comparators/ncycdb_out/

# nmag comparator run: keep normalized *.tsv + run_dram.sh, drop scratch
comparators/nmag/proteomes/
comparators/nmag/dram_in/
comparators/nmag/dram_out/
comparators/nmag/dram_distill/
comparators/nmag/metabolic_in/
comparators/nmag/metabolic_out/

# GTDB-500 concordance: keep normalized *.tsv, reports, DIR_*/CONCORDANCE outputs,
# selection.tsv, query faa/blast; drop downloads, proteomes, per-tool run dirs.
comparators/gtdb500/gtdb_dl/
comparators/gtdb500/proteomes/
comparators/gtdb500/results/
comparators/gtdb500/metabolic_in/
comparators/gtdb500/metabolic_out/
comparators/gtdb500/ncycdb_out/
comparators/gtdb500/_shim/
comparators/gtdb500/CONCORDANCE_prelim.*
